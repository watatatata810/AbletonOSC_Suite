{
  "global": {
    "abletonHost": "127.0.0.1",
    "abletonPort": 11000,
    "httpHost": "0.0.0.0",
    "debug": false
  },
  "packages": [
    {
      "name": "osc-router",
      "dir": "packages/osc-router",
      "type": "node",
      "startCmd": "index.js"
    },
    {
      "name": "viewWaves",
      "dir": "packages/viewWaves",
      "type": "neutralino",
      "dependencies": ["osc-router"]
    },
    {
      "name": "DaihonTrigger",
      "dir": "packages/DaihonTrigger",
      "type": "node",
      "startCmd": "server.js",
      "port": 3001,
      "dependencies": ["osc-router"]
    },
    {
      "name": "OscTester",
      "dir": "packages/OscTester",
      "type": "node",
      "startCmd": "server.js",
      "port": 3010,
      "dependencies": ["osc-router"]
    }
  ],
  "oscRouter": {
    "host": "127.0.0.1",
    "listenPort": 11001
  },
  "viewWaves": {
    "httpPort": 3000,
    "oscPort": 11002,
    "pollInterval": 500
  },
  "daihonTrigger": {
    "httpPort": 3001,
    "oscPort": 11003,
    "oscConcurrencyLimit": 50,
    "oscTimeout": 1000
  },
  "oscTester": {
    "httpPort": 3010,
    "oscPort": 11004
  }
}
